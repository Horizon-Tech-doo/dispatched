{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dispatched",
  "version": "0.1.0",
  "identifier": "io.horizon-tech.dispatched",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dispatched",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 Horizon Tech d.o.o.",
    "category": "DeveloperTool",
    "shortDescription": "Azure Service Bus explorer, agent-ready.",
    "longDescription": "Dispatched — a fast, cross-platform explorer for Azure Service Bus.",
    "publisher": "Horizon Tech d.o.o.",
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Horizon-Tech-doo/dispatched/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4RDJFNzExRDMwM0ZDRjkKUldUNS9BUFRFZWZTR0dwL3RvbWswTSswMC82L3gvYkJpWFFzcHZLNks0Z3Y5MW94ZmR0aGJwdXgK"
    }
  }
}
