<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build only (tauri.appstore.conf.json). The direct download is not sandboxed. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- AMQP, the management API, ARM discovery and Entra sign-in. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The loopback redirect that receives the Entra sign-in in the browser. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Exports, reports and XML files the user picks in a save or open dialog. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>N9H2M3339M.io.horizon-tech.dispatched</string>
	<key>com.apple.developer.team-identifier</key>
	<string>N9H2M3339M</string>
</dict>
</plist>
